<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="1024" prefHeight="768"
            fx:controller="hust.soict.dsai.aims.screen.CartScreenController">

    <!-- TOP: MenuBar + CART header -->
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Options">
                    <Menu text="Update Store">
                        <MenuItem text="Add Book"  onAction="#openAddBook"/>
                        <MenuItem text="Add CD"    onAction="#openAddCD"/>
                        <MenuItem text="Add DVD"   onAction="#openAddDVD"/>
                    </Menu>
                    <MenuItem text="View store" onAction="#viewStore"/>
                    <MenuItem text="View cart"  onAction="#viewCart"/>
                </Menu>
            </MenuBar>

            <Label text="CART"
                   style="-fx-font-size: 50px; -fx-text-fill: #00ffff;">
                <VBox.margin>
                    <Insets left="15" top="5" bottom="5"/>
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- CENTER: Filter row + TableView + ButtonBar -->
    <center>
        <VBox>
            <VBox.margin>
                <Insets left="10"/>
            </VBox.margin>

            <!-- Filter row -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox.margin>
                    <Insets top="10" bottom="10"/>
                </VBox.margin>
                <Label text="Filter:"/>
                <TextField fx:id="tfFilter" prefWidth="180"/>

                <fx:define>
                    <ToggleGroup fx:id="filterGroup"/>
                </fx:define>
                <RadioButton fx:id="radioBtnFilterId"
                             text="By ID"
                             selected="true"
                             toggleGroup="$filterGroup"/>
                <RadioButton fx:id="radioBtnFilterTitle"
                             text="By Title"
                             toggleGroup="$filterGroup"/>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="tblMedia"
                       columnResizePolicy="CONSTRAINED_RESIZE_POLICY"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMediaTitle"    text="Title"/>
                    <TableColumn fx:id="colMediaCategory" text="Category"/>
                    <TableColumn fx:id="colMediaCost"     text="Cost"/>
                </columns>
            </TableView>

            <!-- Button bar: Play + Remove (hidden until row selected) -->
            <ButtonBar>
                <VBox.margin>
                    <Insets top="5" bottom="5"/>
                </VBox.margin>
                <buttons>
                    <Button fx:id="btnPlay"   text="Play"   onAction="#btnPlayPressed"/>
                    <Button fx:id="btnRemove" text="Remove" onAction="#btnRemovePressed"/>
                </buttons>
            </ButtonBar>
        </VBox>
    </center>

    <!-- RIGHT: Total cost + Place Order -->
    <right>
        <VBox alignment="TOP_CENTER" prefWidth="220" spacing="20">
            <VBox.margin>
                <Insets top="50" right="20" left="20"/>
            </VBox.margin>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Total:"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="labelTotalCost" text="0.00 $"
                       style="-fx-font-size: 24px; -fx-text-fill: #00ffff;"/>
            </HBox>

            <Button fx:id="btnPlaceOrder" text="Place Order"
                    onAction="#btnPlaceOrderPressed"
                    maxWidth="Infinity"
                    style="-fx-background-color: red;
                           -fx-text-fill: white;
                           -fx-font-size: 20px;"/>
        </VBox>
    </right>

</BorderPane>
